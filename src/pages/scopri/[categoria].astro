---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ItemList from '../../components/ItemList.astro';
import DownloadPoster from '../../components/DownloadPoster.astro';
import Footer from '../../components/Footer.astro';
import { categories, isPublishedPlace, loadContent, type CategoryKey } from '../../lib/content';

const intros: Record<CategoryKey, string> = {
  nature: 'Laghi, sentieri, boschi e panorami del Molise da raggiungere e da ricordare.',
  history: 'Abbazie, castelli, chiese e monumenti che raccontano la storia del Molise.',
  folklore: 'Tradizioni, riti e luoghi della cultura popolare molisana.',
  food: 'Sagre, sapori e posti dove mangiare bene in Molise.',
  experience: 'Esperienze da vivere in Molise, tra natura, cultura e territorio.',
  allure: 'Attrazioni, feste e appuntamenti da non perdere in Molise.',
};

export async function getStaticPaths() {
  const { places, events } = await loadContent();
  return (Object.keys(categories) as CategoryKey[])
    .map((key) => ({
      key,
      places: places.filter((p) => p.category === key && isPublishedPlace(p)),
      events: events.filter((e) => e.category === key),
    }))
    .filter((c) => c.places.length + c.events.length > 0)
    .map((c) => ({ params: { categoria: categories[c.key].slug }, props: c }));
}

const { key, places, events } = Astro.props;
const cat = categories[key as CategoryKey];
---

<BaseLayout title={`${cat.title}: luoghi ed eventi — Molise Is`} description={intros[key as CategoryKey]}>
  <Header />
  <main class="container page">
    <h1 class="headline">{cat.title}</h1>
    <p class="lede">{intros[key as CategoryKey]}</p>

    {places.length > 0 && (
      <section aria-labelledby="luoghi">
        <h2 id="luoghi" class="section-title">Luoghi</h2>
        <ItemList items={places} label={`Luoghi: ${cat.label}`} />
      </section>
    )}

    {events.length > 0 && (
      <section aria-labelledby="eventi">
        <h2 id="eventi" class="section-title">Eventi</h2>
        <ItemList items={events} label={`Eventi: ${cat.label}`} />
      </section>
    )}

    <nav class="others" aria-label="Altre categorie">
      {Object.values(categories)
        .filter((c) => c.slug !== cat.slug)
        .map((c) => <a class={`chip chip--${c.tone}`} href={`/scopri/${c.slug}/`}>{c.label}</a>)}
    </nav>
  </main>
  <DownloadPoster />
  <Footer />
</BaseLayout>

<style>
  .page {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
  }

  .headline {
    max-width: 14ch;
  }

  .section-title {
    margin: clamp(3rem, 7vw, 5rem) 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 850;
    letter-spacing: -0.02em;
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0.6rem;
    margin-top: clamp(3rem, 7vw, 5rem);
  }
</style>
