---
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<main class="legal container">
  <article class="poster poster--sheet sheet" style="--tilt:-0.4deg">
    <h1 class="headline">{title}</h1>
    <p class="intro">{intro}</p>

    <aside class="draft" role="note">
      <strong>Pagina predisposta.</strong>
      La struttura è pronta per il testo legale definitivo. Il contenuto qui presente è indicativo e non
      sostituisce una privacy policy o termini e condizioni validati.
    </aside>

    <div class="body">
      <slot />
    </div>
  </article>
</main>

<style>
  .legal {
    padding-block: clamp(1.5rem, 4vw, 3rem) var(--section-space);
  }

  .sheet {
    max-width: 50rem;
    padding: clamp(1.75rem, 5vw, 4rem);
  }

  .intro {
    max-width: 40rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .draft {
    margin-top: 2rem;
    padding: 1rem 1.15rem;
    border-radius: 2px;
    color: var(--color-on-tertiary-container);
    background: var(--color-tertiary-container);
    font-size: 0.9rem;
  }

  .body {
    max-width: 65ch;
    margin-top: 2.5rem;
  }

  .body :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .body :global(h2:first-child) {
    margin-top: 0;
  }

  .body :global(p),
  .body :global(li) {
    color: color-mix(in srgb, var(--color-text) 82%, transparent);
  }

  .body :global(ul) {
    padding-left: 1.25rem;
  }

  .body :global(a) {
    color: var(--brand-forest);
    font-weight: 500;
  }
</style>
