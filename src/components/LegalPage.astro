---
interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
---

<main class="legal container">
  <!-- Hung straight: on a sheet this tall any tilt swings its ends off the screen -->
  <article class="poster poster--sheet sheet">
    <h1 class="headline">{title}</h1>
    <p class="updated">Ultimo aggiornamento: {updated}</p>

    <div class="body">
      <slot />
    </div>
  </article>
</main>

<style>
  .legal {
    padding-block: clamp(1.5rem, 4vw, 3rem) var(--section-space);
  }

  .sheet {
    max-width: 50rem;
    padding: clamp(1.75rem, 5vw, 4rem);
  }

  .headline {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
  }

  .updated {
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .body {
    max-width: 65ch;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    overflow-wrap: break-word;
  }

  .body :global(h2) {
    margin: 3rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .body :global(h3) {
    margin: 2rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .body :global(p) {
    margin: 0 0 1em;
    text-wrap: pretty;
  }

  .body :global(ul) {
    margin: 0 0 1em;
    padding-left: 1.25rem;
  }

  .body :global(li + li) {
    margin-top: 0.35em;
  }

  .body :global(li::marker) {
    color: var(--brand-forest);
  }

  .body :global(strong) {
    font-weight: 700;
  }
</style>
