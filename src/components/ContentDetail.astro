---
import { categories, directionsUrl, eventWhen, imageUrl, isPast, paragraphs, type Event, type Media, type Place } from '../lib/content';

interface Props {
  item: Place | Event;
}

const { item } = Astro.props;
const cat = item.category === 'unknown' ? undefined : categories[item.category];
const [cover, ...gallery] = item.media;
const past = item.kind === 'event' && isPast(item);
const city = item.cities?.name;

const credit = (m: Media) => [m.author, m.license].filter(Boolean).join(' · ');
---

<article class="detail container">
  <nav class="crumbs" aria-label="Percorso">
    <a href="/">Molise Is</a>
    <span aria-hidden="true">/</span>
    {item.kind === 'event' ? <a href="/eventi/">Eventi</a> : cat && <a href={`/scopri/${cat.slug}/`}>{cat.label}</a>}
  </nav>

  <div class="layout">
    <div class={`poster poster--sheet text`} style="--tilt:-0.4deg">
      {past && <span class="strip" style="--tilt:4deg">Concluso</span>}
      <h1 class="headline">{item.name}</h1>
      <p class="facts">
        {item.kind === 'event' && <span class="when">{eventWhen(item)}</span>}
        <span>{[cat?.label, city].filter(Boolean).join(' · ')}</span>
      </p>

      {paragraphs(item.description).length > 0 && (
        <div class="body">
          {paragraphs(item.description).map((p) => <p>{p}</p>)}
        </div>
      )}

      <a class="button" href={directionsUrl(item)} rel="noopener noreferrer">Indicazioni stradali</a>
    </div>

    {cover && (
      <figure class={`poster poster--${cat?.tone ?? 'sky'} cover`} style="--tilt:1.6deg">
        <img
          src={imageUrl(cover.url, 1100)}
          alt={cover.description ?? item.name}
          width={cover.width}
          height={cover.height}
          loading="eager"
          referrerpolicy="no-referrer"
        />
        {credit(cover) && (
          <figcaption>
            Foto: {cover.license_url ? <a href={cover.license_url} rel="noopener noreferrer">{credit(cover)}</a> : credit(cover)}
          </figcaption>
        )}
      </figure>
    )}
  </div>

  {gallery.length > 0 && (
    <section class="gallery" aria-label="Altre foto">
      {gallery.map((m, i) => (
        <figure class="poster poster--sheet shot" style={`--tilt:${i % 2 ? '1deg' : '-1.2deg'}`}>
          <img
            src={imageUrl(m.url, 640)}
            alt={m.description ?? item.name}
            width={m.width}
            height={m.height}
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
          {credit(m) && <figcaption>Foto: {m.license_url ? <a href={m.license_url} rel="noopener noreferrer">{credit(m)}</a> : credit(m)}</figcaption>}
        </figure>
      ))}
    </section>
  )}
</article>

<style>
  .detail {
    padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 7vw, 6rem);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .crumbs a {
    color: inherit;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .text {
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .text .strip {
    top: -0.9rem;
    right: -0.8rem;
  }

  .headline {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }

  .facts {
    display: grid;
    gap: 0.2rem;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
  }

  .when::first-letter {
    text-transform: uppercase;
  }

  .when {
    color: var(--color-text);
    font-weight: 700;
  }

  .body {
    max-width: 65ch;
    margin-top: 1.75rem;
  }

  .body p {
    margin: 0 0 1em;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .text .button {
    margin-top: 1.5rem;
  }

  .cover {
    margin: 0;
    padding: 0.75rem;
  }

  .cover img,
  .shot img {
    width: 100%;
    border-radius: 2px;
    object-fit: cover;
  }

  .cover img {
    aspect-ratio: 4 / 5;
  }

  .shot img {
    aspect-ratio: 4 / 3;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  figcaption a {
    color: inherit;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .shot {
    margin: 0;
    padding: 0.6rem;
  }

  @media (max-width: 52rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .cover {
      order: -1;
    }

    .cover img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
