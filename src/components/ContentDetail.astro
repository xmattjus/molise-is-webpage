---
import { categories, directionsUrl, eventWhen, imageSrcset, imageUrl, isPast, paragraphs, type Event, type Media, type Place } from '../lib/content';

interface Props {
  item: Place | Event;
}

const { item } = Astro.props;
const cat = item.category === 'unknown' ? undefined : categories[item.category];
const [cover, ...gallery] = item.media;
const past = item.kind === 'event' && isPast(item);
const city = item.cities?.name;
const description = paragraphs(item.description);

// The details sheet: add a row here when the app gains a new field (address, price, organiser…)
type Detail = { label: string; value: string; href?: string };
const details = [
  item.kind === 'event' && { label: 'Quando', value: eventWhen(item) },
  city && { label: 'Dove', value: city },
  cat && { label: 'Categoria', value: cat.label, href: `/scopri/${cat.slug}/` },
].filter((d): d is Detail => Boolean(d));

const credit = (m: Media) => [m.author, m.license].filter(Boolean).join(' · ');
---

<article class={`detail container detail--${item.kind}`}>
  <nav class="crumbs" aria-label="Percorso">
    <a href="/">Molise Is</a>
    <span aria-hidden="true">/</span>
    {item.kind === 'event' ? <a href="/eventi/">Eventi</a> : cat && <a href={`/scopri/${cat.slug}/`}>{cat.label}</a>}
  </nav>

  <div class="layout">
    <div class="poster poster--sheet text" style="--tilt:-0.4deg">
      <h1 class="headline">{item.name}</h1>
      {description.length > 0 && (
        <div class="body">
          {description.map((p) => <p>{p}</p>)}
        </div>
      )}
    </div>

    <div class="side">
      {cover && (
        <figure class={`poster poster--${cat?.tone ?? 'sky'} cover`} style="--tilt:1.6deg">
          <img
            src={imageUrl(cover.url, 1100)}
            srcset={imageSrcset(cover.url, [400, 640, 900, 1100])}
            sizes="(max-width: 52rem) calc(100vw - 3.5rem), 34rem"
            alt={cover.description ?? item.name}
            width={cover.width}
            height={cover.height}
            loading="eager"
            referrerpolicy="no-referrer"
          />
          {credit(cover) && (
            <figcaption>
              Foto: {cover.license_url ? <a href={cover.license_url} rel="noopener noreferrer">{credit(cover)}</a> : credit(cover)}
            </figcaption>
          )}
        </figure>
      )}

      <section class="poster poster--sheet info" style="--tilt:-0.8deg" aria-label="Dettagli">
        {past && <span class="strip" style="--tilt:4deg">Concluso</span>}
        <dl>
          {details.map((d) => (
            <div class="row">
              <dt class="tag">{d.label}</dt>
              <dd>{d.href ? <a href={d.href}>{d.value}</a> : d.value}</dd>
            </div>
          ))}
        </dl>
        <a class="button" href={directionsUrl(item)} rel="noopener noreferrer">Indicazioni stradali</a>
      </section>
    </div>
  </div>

  {gallery.length > 0 && (
    <section class="gallery" aria-label="Altre foto">
      {gallery.map((m, i) => (
        <figure class="poster poster--sheet shot" style={`--tilt:${i % 2 ? '1deg' : '-1.2deg'}`}>
          <img
            src={imageUrl(m.url, 640)}
            srcset={imageSrcset(m.url, [320, 480, 640, 960])}
            sizes="(max-width: 40rem) calc(100vw - 3.5rem), 22rem"
            alt={m.description ?? item.name}
            width={m.width}
            height={m.height}
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
          {credit(m) && <figcaption>Foto: {m.license_url ? <a href={m.license_url} rel="noopener noreferrer">{credit(m)}</a> : credit(m)}</figcaption>}
        </figure>
      ))}
    </section>
  )}
</article>

<style>
  .detail {
    padding-block: clamp(1rem, 3vw, 2rem) clamp(3rem, 7vw, 6rem);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .crumbs a {
    color: inherit;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .text {
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .headline {
    font-size: clamp(2.2rem, 5vw, 4rem);
  }

  .body {
    max-width: 65ch;
    margin-top: 1.75rem;
  }

  .body p {
    margin: 0 0 1em;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .body p:last-child {
    margin-bottom: 0;
  }

  .side {
    display: grid;
    gap: 1.5rem;
  }

  .cover {
    margin: 0;
    padding: 0.75rem;
  }

  .cover img,
  .shot img {
    width: 100%;
    border-radius: 2px;
    object-fit: cover;
  }

  .cover img {
    aspect-ratio: 4 / 5;
  }

  /* Event covers are often flyers with the date printed on them: show them whole, on the sheet's stock */
  .detail--event .cover img {
    aspect-ratio: auto;
    height: auto;
    object-fit: contain;
  }

  .info {
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .info .strip {
    top: -0.9rem;
    right: -0.6rem;
  }

  dl {
    margin: 0;
  }

  .row {
    padding-block: 0.7rem;
  }

  .row:first-child {
    padding-top: 0;
  }

  .row + .row {
    border-top: 1px solid var(--color-border);
  }

  dt {
    display: block;
    color: var(--color-text-muted);
  }

  dd {
    margin: 0.2rem 0 0;
    font-weight: 500;
    line-height: 1.4;
  }

  dd::first-letter {
    text-transform: uppercase;
  }

  .info .button {
    width: 100%;
    margin-top: 0.9rem;
  }

  .shot img {
    aspect-ratio: 4 / 3;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    line-height: 1.4;
  }

  figcaption a {
    color: inherit;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .shot {
    margin: 0;
    padding: 0.6rem;
  }

  /* Desktop: the photo and its details travel beside the text. The cap keeps both on screen */
  @media (min-width: 52.01rem) {
    .cover img {
      max-height: calc(100svh - 24rem);
    }
  }

  @media (min-width: 52.01rem) and (min-height: 40rem) {
    .side {
      position: sticky;
      top: 1.5rem;
    }
  }

  /* No description: nothing to scroll past, so the details sit under the title, the poster beside both */
  @media (min-width: 52.01rem) {
    .layout:not(:has(.body)) .side {
      display: contents;
    }

    .layout:not(:has(.body)) .info {
      grid-column: 1;
      max-width: 28rem;
    }

    .layout:not(:has(.body)) .cover {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  /* Phone: photo, then details, then the text */
  @media (max-width: 52rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      order: -1;
    }

    .cover img {
      aspect-ratio: 4 / 3;
    }

    .detail--event .cover img {
      aspect-ratio: auto;
      max-height: 70svh;
    }

    .info .strip {
      right: -0.25rem;
    }
  }
</style>
