// Official Italian badges (Apple Marketing Tools, Google Play badges); never redrawn or recoloured.
---

<div class="badges">
  <a href="https://apps.apple.com/it/app/molise-is/id6747610311" rel="noopener noreferrer">
    <img src="/badges/app-store-it-black.svg" alt="Scarica su App Store" width="144" height="48" />
  </a>
  <a href="https://play.google.com/store/apps/details?id=it.benitomatteobercini.moliseis&hl=it" rel="noopener noreferrer">
    <img src="/badges/google-play-it.png" alt="Disponibile su Google Play" width="162" height="48" />
  </a>
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .badges a {
    display: block;
    border-radius: 9px;
    transition: translate 180ms var(--ease-paste);
  }

  .badges a:hover {
    translate: 0 -2px;
  }

  .badges img {
    width: auto;
    height: 3rem;
  }
</style>
