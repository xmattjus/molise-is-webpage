---
import { categories, eventWhen, imageSrcset, imageUrl, isPast, type Event, type Place } from '../lib/content';

interface Props {
  item: Place | Event;
  index?: number;
}

const { item, index = 0 } = Astro.props;
const cat = item.category === 'unknown' ? undefined : categories[item.category];
const cover = item.media[0];
const href = `/${item.kind === 'place' ? 'luoghi' : 'eventi'}/${item.slug}/`;
const tilts = ['-1.2deg', '0.8deg', '-0.4deg', '1.3deg'];
const meta =
  item.kind === 'event'
    ? `${eventWhen(item)}${isPast(item) ? ' · concluso' : ''}`
    : [cat?.label, item.cities?.name].filter(Boolean).join(' · ');
---

<li class={`poster poster--${cat?.tone ?? 'sheet'} card`} style={`--tilt:${tilts[index % tilts.length]}`}>
  <a href={href}>
    {cover && (
      <img
        src={imageUrl(cover.url, 640)}
        srcset={imageSrcset(cover.url, [320, 480, 640, 960])}
        sizes="(max-width: 40rem) calc(100vw - 3.5rem), 20rem"
        alt={cover.description ?? item.name}
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    )}
    <span class="name">{item.name}</span>
    {item.kind === 'event' && item.cities && <span class="meta">{item.cities.name}</span>}
    <span class="meta">{meta}</span>
  </a>
</li>

<style>
  .card a {
    display: grid;
    gap: 0.35rem;
    height: 100%;
    padding: 0.75rem 0.75rem 1rem;
    color: inherit;
    text-decoration: none;
  }

  .card {
    transition: translate 180ms var(--ease-paste), box-shadow 180ms var(--ease-paste);
  }

  .card:hover {
    translate: 0 calc(var(--lift) * 1.5);
    box-shadow: var(--shadow-paper-lifted);
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-bottom: 0.5rem;
    border-radius: 2px;
    object-fit: cover;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 850;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .meta {
    font-size: 0.85rem;
  }

  .meta::first-letter {
    text-transform: uppercase;
  }
</style>
