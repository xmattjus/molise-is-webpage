---
import { Image } from 'astro:assets';
import logo from '../assets/logo-pin.png';
import { categories } from '../lib/content';
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Image src={logo} alt="" width={24} height={35} />
      <div>
        <strong>Molise Is</strong>
        <p>L'inatteso che ti aspetta</p>
      </div>
    </div>
    <nav class="footer-links" aria-label="Scopri il Molise">
      <a href="/eventi/">Eventi</a>
      {Object.values(categories).map((c) => <a href={`/scopri/${c.slug}/`}>{c.label}</a>)}
    </nav>
    <nav class="footer-links" aria-label="Informazioni legali">
      <a href="/privacy-policy/">Privacy policy</a>
      <a href="/termini-e-condizioni/">Termini di utilizzo</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    padding-block: 2.5rem 3rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-brand img {
    width: 1.5rem;
  }

  strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 850;
    letter-spacing: -0.03em;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.85rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>
