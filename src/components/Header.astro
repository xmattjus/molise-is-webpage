---
import { Image } from 'astro:assets';
import logo from '../assets/logo-pin.png';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <Image class="brand-pin" src={logo} alt="" width={30} height={44} loading="eager" />
      <span class="brand-name">Molise Is</span>
    </a>

    <nav aria-label="Navigazione principale">
      <a class="nav-link" href="/#app">L'app</a>
      <a class="nav-link" href="/#scopri">Scopri</a>
      <a class="button" href="/#download">Scarica</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: 1.25rem;
  }

  .header-inner,
  nav,
  .brand {
    display: flex;
    align-items: center;
  }

  .header-inner {
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-pin {
    width: 1.9rem;
    height: auto;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 850;
    letter-spacing: -0.03em;
  }

  nav {
    gap: clamp(1rem, 3vw, 2rem);
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
  }

  .nav-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 40rem) {
    .nav-link {
      display: none;
    }
  }
</style>
