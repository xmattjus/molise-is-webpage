---
import { Image } from 'astro:assets';
import StoreBadges from './StoreBadges.astro';
import home from '../assets/screenshots/smartphone-1.png';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="wall">
    <div class="poster poster--forest main paste" style="--tilt:-0.8deg;--order:0">
      <span class="strip" style="--tilt:5deg">Gratis su iPhone e Android</span>
      <h1 id="hero-title" class="display"><span class="kern">L’</span>inatteso che ti aspetta.</h1>
      <p class="lede">
        Luoghi, eventi e piccole scoperte da tutto il Molise, in un'app sola. Apri, guarda cosa c'è
        intorno a te, parti.
      </p>
      <div class="info" id="download-hero">
        <p class="tag">Scarica l'app</p>
        <StoreBadges />
      </div>
    </div>

    <figure class="poster poster--sky shot paste" style="--tilt:2.4deg;--order:1">
      <div class="screen">
        <Image src={home} alt="La Home dell'app Molise Is: ricerca, luoghi suggeriti e categorie" widths={[300, 460, 640]} sizes="(max-width: 52rem) 58vw, 22rem" loading="eager" />
      </div>
      <figcaption class="tag">La Home dell'app</figcaption>
    </figure>

    <div class="poster poster--mint place paste" style="--tilt:-3deg;--order:2">
      <p class="tag">Luogo</p>
      <p class="name">Lago Turchese</p>
      <p class="where">Castel San Vincenzo</p>
    </div>

    <div class="poster poster--terra event paste" style="--tilt:3.5deg;--order:3">
      <p class="tag">Evento</p>
      <p class="name">’Ndocciata</p>
      <p class="where">Agnone</p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, 3vw, 2.5rem) clamp(4rem, 8vw, 7rem);
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    align-items: start;
  }

  .main {
    z-index: 2;
    grid-column: 1 / 8;
    grid-row: 1;
    padding: clamp(2rem, 4.5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.25rem);
  }

  .main .strip {
    top: -0.9rem;
    right: -1.2rem;
  }

  .main .display {
    max-width: 8.5ch;
  }

  .kern {
    margin-right: 0.05em;
  }

  .main .lede {
    color: color-mix(in srgb, var(--brand-ivory) 88%, transparent);
  }

  /* The info band at the poster's foot: where the action lives */
  .info {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: 1rem 1.1rem 1.15rem;
    border-radius: 2px;
    color: var(--color-text);
    background: var(--color-sheet);
    width: fit-content;
    max-width: 100%;
  }

  .shot {
    z-index: 3;
    grid-column: 8 / 12;
    grid-row: 1 / 3;
    margin: 3.5rem 0 0 -2.5rem;
    padding: 0.85rem 0.85rem 0.9rem;
  }

  .shot .screen img {
    aspect-ratio: 10 / 15;
    object-fit: cover;
    object-position: top;
  }

  .shot figcaption {
    display: block;
    margin-top: 0.8rem;
  }

  .place,
  .event {
    padding: 1rem 1.1rem 1.15rem;
  }

  .place {
    z-index: 3;
    grid-column: 3 / 6;
    grid-row: 2;
    margin: -2.5rem 0 0 1rem;
  }

  .event {
    z-index: 4;
    grid-column: 10 / 13;
    grid-row: 2;
    align-self: end;
    margin: 0 -0.5rem -2.5rem 2rem;
  }

  .name {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    font-weight: 850;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .where {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
  }

  @media (max-width: 64rem) {
    .main {
      grid-column: 1 / 9;
    }

    .shot {
      grid-column: 9 / 13;
      margin-left: -2rem;
    }

    .place {
      grid-column: 2 / 6;
    }

    .event {
      grid-column: 8 / 12;
    }
  }

  @media (max-width: 46rem) {
    .wall {
      grid-template-rows: auto auto auto;
    }

    .main {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .shot {
      grid-column: 1 / 8;
      grid-row: 2;
      margin: -1rem 0 0 0.75rem;
    }

    .place {
      display: block;
      grid-column: 8 / 13;
      grid-row: 2;
      margin: 2.5rem -0.25rem 0 -0.75rem;
    }

    .event {
      grid-column: 7 / 13;
      grid-row: 2;
      margin: 0 0 -1.5rem 0;
    }
  }
</style>
